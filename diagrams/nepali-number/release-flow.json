{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Release flow",
    "subtitle": "From a pull request through release-please to npm",
    "quality_profile": "showcase",
    "output": "release-flow.html"
  },
  "lanes": [
    {
      "id": "owner",
      "label": "Owner"
    },
    {
      "id": "checks",
      "label": "CI"
    },
    {
      "id": "release",
      "label": "Release"
    }
  ],
  "mainPath": [
    "pr",
    "main",
    "rp",
    "rpr",
    "tag",
    "pub",
    "npm"
  ],
  "nodes": [
    {
      "id": "pr",
      "lane": "owner",
      "col": 0,
      "type": "external",
      "label": "Pull request",
      "sublabel": "Conventional Commit"
    },
    {
      "id": "main",
      "lane": "owner",
      "col": 1,
      "type": "frontend",
      "label": "main",
      "sublabel": ""
    },
    {
      "id": "ci",
      "lane": "checks",
      "col": 1,
      "type": "backend",
      "label": "CI workflow",
      "sublabel": "type-check · test · build, Node 20 / 22 / 24"
    },
    {
      "id": "rp",
      "lane": "release",
      "col": 1,
      "type": "cloud",
      "label": "Release workflow",
      "sublabel": "release-please"
    },
    {
      "id": "rpr",
      "lane": "owner",
      "col": 2,
      "type": "frontend",
      "label": "Release pull request",
      "sublabel": "version + CHANGELOG.md"
    },
    {
      "id": "tag",
      "lane": "release",
      "col": 3,
      "type": "cloud",
      "label": "Tag + GitHub release",
      "sublabel": "with release notes"
    },
    {
      "id": "pub",
      "lane": "release",
      "col": 4,
      "type": "backend",
      "label": "publish job",
      "sublabel": "type-check · test · build"
    },
    {
      "id": "npm",
      "lane": "release",
      "col": 5,
      "type": "external",
      "label": "npm",
      "sublabel": ""
    }
  ],
  "edges": [
    {
      "id": "runs",
      "from": "pr",
      "to": "ci",
      "label": "runs",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "merge",
      "from": "pr",
      "to": "main",
      "label": "owner merges",
      "variant": "emphasis"
    },
    {
      "id": "push",
      "from": "main",
      "to": "rp",
      "label": "push",
      "variant": "emphasis"
    },
    {
      "id": "propose",
      "from": "rp",
      "to": "rpr",
      "label": "opens or updates",
      "variant": "emphasis"
    },
    {
      "id": "release",
      "from": "rpr",
      "to": "tag",
      "label": "owner merges",
      "variant": "emphasis"
    },
    {
      "id": "build",
      "from": "tag",
      "to": "pub",
      "label": "",
      "variant": "emphasis"
    },
    {
      "id": "publish",
      "from": "pub",
      "to": "npm",
      "label": "trusted publishing, provenance",
      "variant": "emphasis"
    }
  ]
}
