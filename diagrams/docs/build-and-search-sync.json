{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Build and search sync",
    "subtitle": "A push to main: Vercel builds with bun run build, the records go to Algolia, then the deployment goes live",
    "quality_profile": "showcase",
    "animation": "trace",
    "output": "build-and-search-sync.html"
  },
  "participants": [
    {
      "id": "owner",
      "type": "external",
      "label": "Owner",
      "sublabel": "pushes main"
    },
    {
      "id": "vercel",
      "type": "cloud",
      "label": "Vercel",
      "sublabel": "production build"
    },
    {
      "id": "next",
      "type": "backend",
      "label": "next build",
      "sublabel": "Fumadocs MDX"
    },
    {
      "id": "out",
      "type": "database",
      "label": ".next/ output",
      "sublabel": "build files"
    },
    {
      "id": "sync",
      "type": "backend",
      "label": "sync-content.ts",
      "sublabel": "Node 26"
    },
    {
      "id": "algolia",
      "type": "cloud",
      "label": "Algolia",
      "sublabel": "index document"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 250,
      "label": "Start"
    },
    {
      "from": 260,
      "to": 355,
      "label": "Build"
    },
    {
      "from": 365,
      "to": 565,
      "label": "Sync"
    },
    {
      "from": 575,
      "to": 615,
      "label": "Live"
    }
  ],
  "messages": [
    {
      "id": "push",
      "from": "owner",
      "to": "vercel",
      "y": 165,
      "label": "git push to main",
      "variant": "emphasis"
    },
    {
      "id": "gate",
      "from": "vercel",
      "to": "owner",
      "y": 200,
      "label": "other branches: no deployment",
      "variant": "return"
    },
    {
      "id": "prep",
      "from": "vercel",
      "to": "next",
      "y": 235,
      "label": "full clone, Bun 1.4.4 install, history check",
      "variant": "default"
    },
    {
      "id": "run",
      "from": "vercel",
      "to": "next",
      "y": 275,
      "label": "bun run build",
      "variant": "emphasis"
    },
    {
      "id": "write",
      "from": "next",
      "to": "out",
      "y": 310,
      "label": "compile content/; pages, Markdown, OG, static.json",
      "variant": "emphasis"
    },
    {
      "id": "done",
      "from": "next",
      "to": "vercel",
      "y": 345,
      "label": "build done",
      "variant": "return"
    },
    {
      "id": "second",
      "from": "vercel",
      "to": "sync",
      "y": 380,
      "label": "same command, second step",
      "variant": "default"
    },
    {
      "id": "glob",
      "from": "sync",
      "to": "out",
      "y": 415,
      "label": "variables checked; glob static.json.body",
      "variant": "default"
    },
    {
      "id": "records",
      "from": "out",
      "to": "sync",
      "y": 450,
      "label": "records",
      "variant": "return"
    },
    {
      "id": "sendrec",
      "from": "sync",
      "to": "algolia",
      "y": 485,
      "label": "sync with ALGOLIA_WRITE_KEY",
      "variant": "security"
    },
    {
      "id": "ok",
      "from": "algolia",
      "to": "sync",
      "y": 520,
      "label": "ok",
      "variant": "return"
    },
    {
      "id": "updated",
      "from": "sync",
      "to": "vercel",
      "y": 555,
      "label": "search updated: N records",
      "variant": "return"
    },
    {
      "id": "live",
      "from": "vercel",
      "to": "owner",
      "y": 595,
      "label": "deployment live at SITE_URL",
      "variant": "return"
    }
  ]
}