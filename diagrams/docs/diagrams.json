{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "App flow — diagrams",
    "subtitle": "The Archify view on the page, the Mermaid in every Markdown surface (ADR-0022, proposed)",
    "quality_profile": "showcase",
    "output": "diagrams.html"
  },
  "lanes": [
    {
      "id": "reader",
      "label": "Reader"
    },
    {
      "id": "page",
      "label": "Docs page"
    },
    {
      "id": "frame",
      "label": "Diagram frame"
    },
    {
      "id": "text",
      "label": "Markdown"
    }
  ],
  "mainPath": [
    "person",
    "docs",
    "view",
    "full"
  ],
  "nodes": [
    {
      "id": "person",
      "lane": "reader",
      "col": 0,
      "type": "external",
      "label": "Reader",
      "sublabel": "search, link or URL"
    },
    {
      "id": "tool",
      "lane": "reader",
      "col": 2,
      "type": "external",
      "label": "Tool or LLM",
      "sublabel": "or Copy Markdown"
