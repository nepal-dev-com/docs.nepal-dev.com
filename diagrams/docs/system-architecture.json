        "next",
        "sync"
      ]
    },
    {
      "kind": "region",
      "label": "Deployed site",
      "wraps": [
        "proxy",
        "home",
        "pages",
        "diagram",
        "md",
        "og",
        "rec",
        "crawl"
      ]
    }
  ],
  "connections": [
    {
      "from": "content",
      "to": "next",
      "label": "compiled",
      "variant": "emphasis"
    },
    {
      "from": "next",
