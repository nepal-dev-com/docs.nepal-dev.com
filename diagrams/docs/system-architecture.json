{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "System architecture",
    "subtitle": "content/ through the build to the deployed site, Algolia, the analytics and the people who read it",
    "quality_profile": "showcase",
    "animation": "trace",
    "output": "system-architecture.html"
  },
  "layout": {
    "mode": "grid",
    "cols": 5,
    "cellW": 170,
    "cellH": 64,
    "gapX": 70,
    "gapY": 46,
    "origin": [
      60,
      90
    ]
  },
  "components": [
    {
      "id": "reader",
      "type": "external",
      "label": "Reader",
      "sublabel": "browser",
      "row": 0,
      "col": 1
    },
    {
      "id": "bot",
      "type": "external",
      "label": "LLM tools",
      "sublabel": "and crawlers",
      "row": 0,
      "col": 2
    },
    {
      "id": "content",
      "type": "database",
      "label": "content/",
      "sublabel": "MDX + catalogue",
      "row": 2,
      "col": 0
    },
    {
      "id": "next",
      "type": "backend",
      "label": "next build",
      "sublabel": "checks, static output",
      "row": 2,
      "col": 1
    },
    {
      "id": "sync",
