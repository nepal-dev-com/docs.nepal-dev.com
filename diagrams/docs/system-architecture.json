    {
      "id": "vercel",
      "type": "cloud",
      "label": "Vercel Analytics",
      "sublabel": "views, vitals, no cookies",
      "row": 0,
      "col": 0
    },
    {
      "id": "ga",
      "type": "cloud",
      "label": "Google Analytics",
      "sublabel": "Consent Mode v2",
      "row": 1,
      "col": 0
