      "sublabel": "redirects, Markdown, 404",
      "row": 1,
      "col": 2
    },
    {
      "id": "home",
      "type": "frontend",
      "label": "/ home page",
      "row": 1,
      "col": 3
    },
    {
      "id": "pages",
      "type": "frontend",
      "label": "/slug pages",
      "row": 2,
      "col": 3
    },
    {
      "id": "diagram",
      "type": "frontend",
      "label": "/diagrams/",
      "sublabel": "Archify, shell",
      "row": 3,
      "col": 3
    },
    {
      "id": "md",
      "type": "frontend",
      "label": "Markdown",
      "sublabel": "llms.txt, llms-full",
      "row": 1,
      "col": 4
