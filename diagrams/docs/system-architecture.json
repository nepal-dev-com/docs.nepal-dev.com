      "label": "prerenders",
      "variant": "emphasis"
    },
    {
      "from": "next",
      "to": "sync",
      "label": "then",
      "variant": "default"
    },
    {
      "from": "sync",
      "to": "algolia",
      "label": "write key",
      "variant": "security"
    },
    {
      "from": "reader",
      "to": "proxy",
      "label": "visits",
      "variant": "emphasis"
    },
    {
      "from": "bot",
      "to": "proxy",
      "label": "fetches",
      "variant": "default"
    },
    {
      "from": "proxy",
      "to": "home",
      "variant": "default"
    },
    {
      "from": "proxy",
      "to": "md",
      "label": "Markdown",
      "variant": "default"
    },
    {
      "from": "pages",
      "to": "diagram",
      "label": "frames",
      "variant": "dashed"
    },
    {
      "from": "reader",
      "to": "algolia",
      "label": "search-only key",
      "variant": "dashed"
    },
    {
      "from": "proxy",
      "to": "crawl",
      "label": "crawlers",
      "variant": "default"
    },
    {
      "from": "reader",
      "to": "vercel",
      "label": "no query string",
      "variant": "dashed"
    },
    {
      "from": "reader",
      "to": "ga",
      "label": "cookies if allowed",
      "variant": "dashed"
    }
