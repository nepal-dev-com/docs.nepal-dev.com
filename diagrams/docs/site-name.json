{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "App flow: the site's name",
    "subtitle": "The site is Puncoz Verse; its own documentation is Puncoz Verse Docs",
    "quality_profile": "showcase",
    "output": "site-name.html"
  },
  "lanes": [
    {
      "id": "in",
      "label": "Arrives"
    },
    {
      "id": "site",
      "label": "Site"
    },
    {
      "id": "out",
      "label": "Elsewhere"
    }
  ],
  "mainPath": [
    "home",
    "docs"
  ],
  "nodes": [
    {
      "id": "shared",
      "lane": "in",
      "col": 0,
      "type": "external",
      "label": "Shared link"
    },
    {
      "id": "ai",
      "lane": "in",
      "col": 2,
      "type": "external",
      "label": "AI tool"
    },
    {
      "id": "home",
      "lane": "site",
      "col": 0,
      "type": "frontend",
      "label": "Home page",
      "sublabel": "Puncoz Verse"
    },
    {
      "id": "docs",
      "lane": "site",
      "col": 1,
      "type": "frontend",
      "label": "/docs",
      "sublabel": "Puncoz Verse Docs"
    },
    {
      "id": "pkg",
      "lane": "site",
      "col": 2,
      "type": "frontend",
      "label": "/lodestar",
      "sublabel": "header: Puncoz Verse"
    },
    {
      "id": "llms",
      "lane": "out",
      "col": 2,
      "type": "backend",
      "label": "llms.txt",
      "sublabel": "# Puncoz Verse"
    }
  ],
  "edges": [
    {
      "id": "card",
      "from": "home",
      "to": "docs",
      "label": "planet card",
      "variant": "emphasis"
    },
    {
      "id": "pcard",
      "from": "home",
      "to": "pkg",
      "label": "a package card",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "w1",
      "from": "docs",
      "to": "home",
      "label": "wordmark",
      "variant": "dashed",
      "role": "return"
    },
    {
      "id": "og",
      "from": "shared",
      "to": "pkg",
      "label": "Open Graph image",
      "variant": "default"
    },
    {
      "id": "l",
      "from": "ai",
      "to": "llms",
      "label": "index heading",
      "variant": "default"
    }
  ]
}
