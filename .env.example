# Every variable the site reads, names only (AGENTS.md §9). Copy to .env.local and fill in.
# What each one is, and how it is handled: content/docs/maintain/security/secrets.mdx

# The site's public address, an https origin with no path. Public, and read only on the server. Without it
# every page is noindex and `bun run build` refuses to publish (ADR-0035).
SITE_URL=

# Algolia application ID. Public: NEXT_PUBLIC_ inlines it into the browser bundle.
NEXT_PUBLIC_ALGOLIA_APP_ID=

# Algolia search-only key. Public by design, and it can read every record in the index.
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# Google Analytics 4 measurement ID, G- then capital letters and digits. Public: NEXT_PUBLIC_ inlines it into every page.
# Set it in the host's Production environment only. Empty: no Google Analytics, no banner, no footer link. A malformed
# value fails the build (ADR-0041).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Algolia key with write access. Secret. Read only by scripts/sync-content.ts during `bun run build`.
ALGOLIA_WRITE_KEY=

# Vercel only: `true` in the Production environment, so the build clones the full git history for the sitemap's lastmod.
# Not needed locally. A shallow clone fails the build (scripts/require-full-history.sh, ADR-0042).
VERCEL_DEEP_CLONE=
